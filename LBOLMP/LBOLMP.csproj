<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LBOLMP</AssemblyName>
    <RootNamespace>LBOLMP</RootNamespace>
    <!-- Keep in step with MpInfo.Version, modinfo.json and manifest.json. -->
    <Version>0.10.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)\..\output</OutputPath>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;NU1701</NoWarn>
    <PublicizerRuntimeStrategies>IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
    <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <GameFolder>C:\Program Files (x86)\Steam\steamapps\common\LBoL</GameFolder>
    <ManagedFolder>$(GameFolder)\LBoL_Data\Managed</ManagedFolder>
    <BepInExCore>C:\Program Files (x86)\Steam\steamapps\workshop\content\1140150\3483706823\BepInEx\core_5_4_23_4</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Publicize the whole game so we can reach private/internal state without reflection soup. -->
  <ItemGroup>
    <Publicize Include="LBoL.Base" />
    <Publicize Include="LBoL.ConfigData" />
    <Publicize Include="LBoL.Core" />
    <Publicize Include="LBoL.EntityLib" />
    <Publicize Include="LBoL.Presentation" />
    <Publicize Include="Untitled.ConfigDataBuilder.Base" />
  </ItemGroup>

  <!--
    Members this mod *overrides* rather than calls, which publicizing would break.
    tl;dr: publicizing everything by default cannot be done. We selectively publicize things to keep our sideloader stuff not publicized.
    Frankly the whole business about publicizer is beyond me, this is the first time I used it purposefully and only out of necessity.
  -->
  <ItemGroup>
    <!-- LBOLMP.Entities.MpResilient -->
    <DoNotPublicize Include="LBoL.Core:LBoL.Core.StatusEffects.StatusEffect.OnAdded" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LBoL.Base"><HintPath>$(ManagedFolder)\LBoL.Base.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="LBoL.ConfigData"><HintPath>$(ManagedFolder)\LBoL.ConfigData.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="LBoL.Core"><HintPath>$(ManagedFolder)\LBoL.Core.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="LBoL.EntityLib"><HintPath>$(ManagedFolder)\LBoL.EntityLib.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="LBoL.Presentation"><HintPath>$(ManagedFolder)\LBoL.Presentation.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Untitled.ConfigDataBuilder.Base"><HintPath>$(ManagedFolder)\Untitled.ConfigDataBuilder.Base.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UniTask"><HintPath>$(ManagedFolder)\UniTask.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="DOTween"><HintPath>$(ManagedFolder)\DOTween.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="DOTween.Modules"><HintPath>$(ManagedFolder)\DOTween.Modules.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="spine-csharp"><HintPath>$(ManagedFolder)\spine-csharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="spine-unity"><HintPath>$(ManagedFolder)\spine-unity.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedFolder)\Unity.TextMeshPro.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(ManagedFolder)\Unity.Addressables.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(ManagedFolder)\Unity.ResourceManager.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(ManagedFolder)\Unity.InputSystem.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="YamlDotNet"><HintPath>$(ManagedFolder)\YamlDotNet.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(ManagedFolder)\com.rlabrecque.steamworks.net.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedFolder)\UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedFolder)\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedFolder)\UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedFolder)\UnityEngine.InputLegacyModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedFolder)\UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedFolder)\UnityEngine.UI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedFolder)\UnityEngine.UIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedFolder)\UnityEngine.ImageConversionModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedFolder)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedFolder)\UnityEngine.AudioModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedFolder)\UnityEngine.AnimationModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedFolder)\UnityEngine.PhysicsModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ManagedFolder)\UnityEngine.AssetBundleModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="LBoL-Entity-Sideloader"><HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\1140150\3572815053\LBoL-Entity-Sideloader.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <!--
    Everything that ships, so that the output folder is the package.
  -->
  <ItemGroup>
    <!-- Read by the game's mod loader. -->
    <None Update="modinfo.json"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <!-- Thunderstore's package manifest. -->
    <None Update="manifest.json"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <!-- Thunderstore's package icon, and the preview the in-game mod loader shows. -->
    <None Update="icon.png"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <None Update="Resources\**"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
  </ItemGroup>

  <Target Name="CleanupDeps" AfterTargets="PostBuildEvent">
    <Delete Files="$(OutputPath)$(AssemblyName).deps.json" ContinueOnError="true" />
  </Target>

  <!-- Stop VS from """helpfully""" incorrectly assuming the schema for the Thunderstore manifest.json file and then complaining about it -->
  <ProjectExtensions><VisualStudio><UserProperties manifest_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>
